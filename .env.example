# 複製這個檔案成 .env 後填入實際值。.env 已列入 .gitignore，不會進版控。
#
#   cp .env.example .env        # Git Bash
#   copy .env.example .env      # PowerShell / cmd

# SQL Server SA 密碼
# 規則：至少 8 個字元，且必須包含大寫、小寫、數字、符號其中三種以上，
#       不符合的話容器會啟動失敗（docker compose logs mssql 看得到錯誤）
MSSQL_SA_PASSWORD=

# Riot API 開發用金鑰（申請，24 小時失效）
# 這個值會被 docker-compose.yml 讀走，設成 API 容器的環境變數 RiotApi__ApiKey。
# 本機直接跑 API（不透過容器）時走的是 User Secrets，不看這裡。
# 正式環境使用它 ! (備註 : 測試環境請使用測試金鑰 User Secrets Or appsettings.Development.json )
RIOT_API_KEY=
